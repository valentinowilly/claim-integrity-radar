# Reference for the backend's environment variables. The application reads them from the
# process environment (service manager, shell); it does not load this file. Never commit real
# values: copy to a private location, fill in, and keep it out of the repository.

# --- Operational database -------------------------------------------------------------------
# PostgreSQL for every store (auth, reviews, batches, runs, validations, jobs). When set, the
# SQLite paths below are ignored. Create the schema first: python -m scripts.db_migrate
CIR_DATABASE_URL=postgresql://cir_app:CHANGE_ME@127.0.0.1:5432/cir
# Optional: run inside a dedicated schema instead of the user's default search_path.
# CIR_DATABASE_SCHEMA=cir
# Connection pool per API process (default 10) and wait for a free connection in seconds (default 10).
# CIR_DATABASE_POOL_MAX=10
# CIR_DATABASE_POOL_TIMEOUT_SECONDS=10
# A validation job whose heartbeat is older than this is marked interrupted (default 120).
# CIR_VALIDATION_JOB_STALE_SECONDS=120

# SQLite files, used only when CIR_DATABASE_URL is empty (local development, tests, and the
# source side of python -m scripts.migrate_sqlite_to_postgres).
# CIR_BATCH_DB_PATH=/srv/cir-data/data_batches.sqlite3
# CIR_REVIEW_DB_PATH=/srv/cir-data/review_workflow.sqlite3
# CIR_AUTH_DB_PATH=/srv/cir-data/review_workflow.sqlite3

# --- Sessions and security -----------------------------------------------------------------
CIR_COOKIE_SECURE=true
# CIR_SESSION_TTL_SECONDS=28800
# CIR_RATE_LIMIT_ENABLED=true
# Set only while bootstrapping the first administrator, then remove.
# CIR_ADMIN_BOOTSTRAP_SECRET=

# --- Local FKRTL sample (only on an authorised local machine; never on a demo host) ---------
# BPJS_FKRTL_SAMPLE_PATH=
# CIR_FKRTL_PSEUDONYM_KEY=
# BPJS_FKRTL_DATE_FROM=2024-03-04
# BPJS_FKRTL_DATE_TO=2024-03-10
# BPJS_FKRTL_MAX_ROWS=50000

# --- ML artifact ------------------------------------------------------------------------------
# Defaults to backend/models/cir-iforest-fkrtl-v2.
# CIR_ML_MODEL_DIR=
