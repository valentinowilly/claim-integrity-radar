# Pengaturan untuk docker compose. Salin menjadi .env lalu isi. Jangan pernah meng-commit .env.

# Sandi database PostgreSQL di dalam jaringan compose (wajib).
CIR_DB_PASSWORD=

# Rahasia sekali pakai untuk membuat administrator pertama. Isi, jalankan bootstrap, lalu kosongkan lagi.
CIR_ADMIN_BOOTSTRAP_SECRET=

# Port web di server ini.
CIR_WEB_PORT=8080

# true bila diakses lewat HTTPS (wajib di produksi); false hanya untuk uji coba lokal lewat http://localhost.
CIR_COOKIE_SECURE=true

# Folder kiriman harian (CSV) di server ini dan jam pengambilan otomatis.
# CIR_INBOX_HOST_DIR=./kiriman
# CIR_INBOX_DAILY_AT=06:00

# Folder model AI Pola Klaim (hasil pelatihan lokal; tidak ikut repositori).
# CIR_ML_MODEL_HOST_DIR=./backend/models

# Model bahasa untuk membaca catatan klinis dan dokumen bebas (endpoint kompatibel OpenAI).
# Dengan profil gpu:  CIR_LLM_BASE_URL=http://llm:8000/v1
# Kosong: sistem tetap berjalan; catatan dibaca dengan aturan teks dan isian formulir tetap dibaca.
CIR_LLM_BASE_URL=
CIR_LLM_MODEL=google/gemma-4-31b-it
CIR_LLM_API_KEY=
# Token Hugging Face untuk mengunduh bobot model (hanya saat profil gpu pertama kali dijalankan).
HF_TOKEN=
